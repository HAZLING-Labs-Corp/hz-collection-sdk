<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 🔴 ESTE RENGLÓN LO PONE CADA COMERCIO, y no puede venir del paquete.
         Android exige que sea la APLICACIÓN la que declare qué precisión quiere, y eso
         es una decisión de producto: `COARSE` es la zona —la acepta ~40% de la gente— y
         `FINE` es la posición exacta, que acepta ~25% y obliga a declararla aparte en
         Play Console. El paquete no puede elegir por el comercio.

         Sin este renglón, `AkPush.pedirUbicacion()` no muestra ningún diálogo: el sistema
         niega el permiso sin preguntar, y no hay error que lo explique. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Android 13+ pide el permiso en tiempo de ejecución. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ══ RASTREO (lib/main_rastreo.dart) ══
         Los declara la APLICACIÓN, nunca el SDK (su manifiesto está vacío). Sin estos cinco,
         el rastreo se apaga solo y lo dice en el diagnóstico:
           · FINE — el GPS preciso mientras la persona se mueve;
           · BACKGROUND + FOREGROUND_SERVICE(+_LOCATION) — seguir grabando con la app en el
             fondo, con el aviso fijo en la barra;
           · ACTIVITY_RECOGNITION — que el sistema diga «va en vehículo» sin prender el GPS.
         🔴 BACKGROUND es nivel 3: revisión manual de Google con video. Ver
         lib/src/permisologia/catalogo_de_permisos.dart. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="${nombreDeLaApp}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Una actividad propia en un paquete FIJO (com.hazling.collection.ejemplo), nombrada
             completa: el identificador del paquete se sigue pudiendo cambiar al compilar sin
             tocar código. Es FlutterActivity más el canal del simulador de recorridos. -->
        <activity
            android:name="com.hazling.collection.ejemplo.ActividadPrincipal"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Canal por defecto de los avisos que dibuja el sistema cuando la app
             está cerrada. El id tiene que coincidir con el canal que crea
             hz_collection_sdk. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
